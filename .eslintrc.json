{
  "root": true,
  "env": {
    "es2022": true
  },
  "ignorePatterns": ["node_modules/", "dist/", "build/", "coverage/"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  }
}


